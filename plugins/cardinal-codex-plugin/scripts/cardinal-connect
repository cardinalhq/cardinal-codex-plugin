#!/usr/bin/env python3
"""Connect Codex to Cardinal telemetry and MCP.

Runs Cardinal's device-code flow, mints ingest and MCP keys, verifies both
endpoints, writes a managed [mcp_servers.cardinal] block into
~/.codex/config.toml, and installs managed Codex hooks that emit Cardinal
agent-session telemetry.

The device flow, endpoint probes, and atomic file helpers come from
cardinal_core (vendored next to hooks/); the TOML config writer and the
Codex hooks.json writer are Codex-specific and stay here.
"""

from __future__ import annotations

import argparse
import json
import re
import shlex
import sys
from datetime import datetime, timezone
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "hooks"))
from cardinal_core import deviceflow  # noqa: E402
from cardinal_core.paths import atomic_write, atomic_write_secret, backup  # noqa: E402


def _load_plugin_version() -> str:
    """Read the canonical version from the sibling plugin.json.

    Same pattern as hooks/_plugin_version.py — one source of truth, no
    hardcoded constants that drift out of sync with releases.
    """
    manifest = Path(__file__).resolve().parent.parent / ".codex-plugin" / "plugin.json"
    try:
        return json.loads(manifest.read_text(encoding="utf-8")).get("version") or "unknown"
    except (OSError, ValueError):
        return "unknown"


PLUGIN_VERSION = _load_plugin_version()
CLIENT_ID = "cardinal-codex-plugin"
MCP_SERVER_NAME = "cardinal"

PLUGIN_ROOT = Path(__file__).resolve().parent.parent
HOOK_SCRIPT = PLUGIN_ROOT / "hooks" / "cardinal-codex-telemetry.py"

CODEX_DIR = Path.home() / ".codex"
CONFIG_PATH = CODEX_DIR / "config.toml"
HOOKS_PATH = CODEX_DIR / "hooks.json"
STATE_PATH = CODEX_DIR / "cardinal.json"
SECRETS_PATH = CODEX_DIR / "cardinal-secrets.json"
PENDING_PATH = CODEX_DIR / "cardinal-pending.json"
# Stable, non-versioned launcher path. hooks.json references THIS, not the
# versioned plugin-cache path, so plugin upgrades don't dangle the command
# (fix for issue: Codex removes the old <version>/ cache dir on upgrade).
LAUNCHER_DIR = CODEX_DIR / "cardinal"
LAUNCHER_PATH = LAUNCHER_DIR / "cardinal-codex-telemetry.py"

BEGIN_MARKER = "# BEGIN cardinal-codex-plugin managed MCP server"
END_MARKER = "# END cardinal-codex-plugin managed MCP server"

UNMANAGED_CARDINAL_TABLE_RE = re.compile(
    r'(?m)^\s*\[mcp_servers\.(?:"cardinal"|cardinal)\]\s*$'
)


def toml_string(value: str) -> str:
    return json.dumps(value)


def write_pending(grant: dict) -> None:
    payload = {
        "verification_uri": grant.get("verification_uri", ""),
        "user_code": grant.get("user_code", ""),
        "expires_in": grant.get("expires_in", deviceflow.DEFAULT_POLL_TIMEOUT_SECS),
        "written_at": datetime.now(timezone.utc).isoformat(),
        "plugin_version": PLUGIN_VERSION,
    }
    atomic_write(PENDING_PATH, json.dumps(payload, indent=2) + "\n")


def clear_pending() -> None:
    try:
        PENDING_PATH.unlink()
    except FileNotFoundError:
        pass


_ANY_TABLE_HEADER_RE = re.compile(r"^\s*\[")
_CARDINAL_TABLE_HEADER_RE = re.compile(
    r'^\s*\[mcp_servers\.(?:"cardinal"|cardinal)(?:\]|\.)'
)


def strip_managed_block(text: str) -> tuple[str, bool]:
    """Remove the plugin-managed Cardinal MCP config from config.toml.

    The BEGIN/END markers are ADVISORY, not a deletion span: Codex rewrites
    config.toml itself and can move its own sections (e.g. [desktop],
    [hooks.state]) inside the marker span (issue #10). Removal is therefore
    parse-aware — only the marker comment lines and the
    [mcp_servers.cardinal] table (header through the line before the next
    table header), wherever they sit, are removed. Foreign content that
    drifted between the markers is preserved verbatim.

    The BEGIN marker still gates the whole operation: without it the file
    is considered unmanaged and returned untouched, so a hand-written
    [mcp_servers.cardinal] table is never deleted.

    Keep this function in lockstep with cardinal-disconnect.
    """
    if BEGIN_MARKER not in text:
        return text, False
    out: list[str] = []
    in_cardinal = False
    for line in text.splitlines(keepends=True):
        stripped = line.strip()
        if stripped.startswith(BEGIN_MARKER) or stripped.startswith(END_MARKER):
            continue
        if in_cardinal:
            if _ANY_TABLE_HEADER_RE.match(line):
                in_cardinal = False  # table ended; fall through for this line
            else:
                continue
        if _CARDINAL_TABLE_HEADER_RE.match(line):
            in_cardinal = True
            continue
        out.append(line)
    new_text = re.sub(r"\n{3,}", "\n\n", "".join(out)).strip("\n")
    return (new_text + "\n" if new_text else ""), True


def build_managed_block(mcp_url: str, api_key: str) -> str:
    return (
        f"{BEGIN_MARKER}\n"
        f"[mcp_servers.{MCP_SERVER_NAME}]\n"
        f"url = {toml_string(mcp_url)}\n"
        f'http_headers = {{ "X-CardinalHQ-API-Key" = {toml_string(api_key)} }}\n'
        f"{END_MARKER}\n"
    )


def write_codex_config(mcp_url: str, api_key: str) -> Path | None:
    text = CONFIG_PATH.read_text() if CONFIG_PATH.exists() else ""
    text_without_managed, _ = strip_managed_block(text)
    if UNMANAGED_CARDINAL_TABLE_RE.search(text_without_managed):
        sys.exit(
            f"Refusing to write because {CONFIG_PATH} already contains an unmanaged "
            "[mcp_servers.cardinal] table. Remove or rename that table, then rerun."
        )

    block = build_managed_block(mcp_url, api_key)
    new_text = text_without_managed.rstrip()
    if new_text:
        new_text += "\n\n"
    new_text += block

    CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True)
    backup_path = backup(CONFIG_PATH)
    atomic_write(CONFIG_PATH, new_text)
    return backup_path


def load_json_object(path: Path, label: str) -> dict:
    if not path.exists():
        return {}
    try:
        data = json.loads(path.read_text())
    except json.JSONDecodeError as exc:
        sys.exit(f"Refusing to write: {label} ({path}) is not valid JSON ({exc}).")
    if not isinstance(data, dict):
        sys.exit(f"Refusing to write: {label} ({path}) is not a JSON object.")
    return data


STORYBOARD_CONTEXT_MATCHER = "^mcp__cardinal__storyboard__(create|add_act|publish|find)$"


def managed_hook_command(event_name: str) -> str:
    return (
        f"python3 {shlex.quote(str(LAUNCHER_PATH))} "
        f"--event {shlex.quote(event_name)} # cardinal-codex-plugin"
    )


# Stable launcher script. Codex hooks.json points here, and this shim
# resolves the connected plugin root or newest installed cache at invocation
# time. Written atomically on every connect; overwrites cleanly on upgrade.
LAUNCHER_TEMPLATE = '''\
#!/usr/bin/env python3
"""cardinal-codex-plugin telemetry launcher (stable path).

Installed by cardinal-connect at ~/.codex/cardinal/. hooks.json references
THIS file, not the versioned plugin-cache path — so when Codex upgrades the
plugin and removes the old cache dir, hooks.json still resolves.

Behavior: prefer the plugin root known at connect time, then fall back to the
newest installed plugin version under
~/.codex/plugins/cache/<owner>/cardinal-codex-plugin/*/. This keeps a connected
development checkout authoritative while still surviving removal of an old
versioned cache directory during a normal plugin upgrade.

Telemetry is best-effort: any failure exits 0 silently, per the same
policy as the hook itself.
"""
from __future__ import annotations

import os
import sys
from pathlib import Path

# Populated by cardinal-connect at install time.
FALLBACK_PLUGIN_ROOT = Path({fallback_root_repr})
TELEMETRY_REL = Path("hooks") / "cardinal-codex-telemetry.py"


def _version_key(name):
    parts = []
    for segment in name.split("."):
        try:
            parts.append((0, int(segment)))
        except ValueError:
            parts.append((1, segment))
    return tuple(parts)


def _discover_newest_cached(hook_rel):
    cache_root = Path.home() / ".codex" / "plugins" / "cache"
    if not cache_root.is_dir():
        return None
    candidates = []
    for owner_dir in cache_root.iterdir():
        plugin_dir = owner_dir / "cardinal-codex-plugin"
        if not plugin_dir.is_dir():
            continue
        for version_dir in plugin_dir.iterdir():
            hook = version_dir / hook_rel
            if version_dir.is_dir() and hook.is_file():
                candidates.append((version_dir.name, hook))
    if not candidates:
        return None
    candidates.sort(key=lambda pair: _version_key(pair[0]))
    return candidates[-1][1]


def main():
    arguments = sys.argv[1:]
    hook_rel = TELEMETRY_REL
    fallback_hook = FALLBACK_PLUGIN_ROOT / hook_rel
    hook = fallback_hook if fallback_hook.is_file() else _discover_newest_cached(hook_rel)
    if hook is None:
        # Silent no-op: telemetry must not break the agent loop.
        return 0
    os.execvp(sys.executable, [sys.executable, str(hook), *arguments])


if __name__ == "__main__":
    sys.exit(main())
'''


def render_launcher() -> str:
    return LAUNCHER_TEMPLATE.format(fallback_root_repr=repr(str(PLUGIN_ROOT)))


def write_launcher() -> None:
    LAUNCHER_DIR.mkdir(parents=True, exist_ok=True)
    atomic_write(LAUNCHER_PATH, render_launcher())
    LAUNCHER_PATH.chmod(0o755)


def managed_hook_group(event_name: str, timeout: int, status_message: str | None = None) -> dict:
    hook = {
        "type": "command",
        "command": managed_hook_command(event_name),
        "timeout": timeout,
    }
    if status_message:
        hook["statusMessage"] = status_message
    return {
        "matcher": "",
        "hooks": [hook],
    }


def _is_managed_or_legacy_semantic_hook(command: object) -> bool:
    """Match anything this plugin has ever written into hooks.json.

    The `semantic-dag` clause is now a pure cleanup path: the Semantic
    DAG skill is gone, but installs connected before its removal still
    carry prompt/tool hook entries pointing at deleted files. Reconnect
    (or `--repair-hooks`) strips them here. Do not drop this clause
    until those versions are unsupported.
    """
    value = str(command or "")
    return "cardinal-codex-plugin" in value or (
        "semantic-dag" in value
        and ("prompt_hook.py" in value or "tool_hook.py" in value)
    )


def strip_managed_hooks(data: dict) -> dict:
    hooks = data.get("hooks")
    if not isinstance(hooks, dict):
        data["hooks"] = {}
        return data
    for event_name, groups in list(hooks.items()):
        if not isinstance(groups, list):
            continue
        kept_groups = []
        for group in groups:
            if not isinstance(group, dict):
                kept_groups.append(group)
                continue
            handlers = group.get("hooks")
            if not isinstance(handlers, list):
                kept_groups.append(group)
                continue
            kept_handlers = [
                h for h in handlers
                if not (
                    isinstance(h, dict)
                    and _is_managed_or_legacy_semantic_hook(h.get("command"))
                )
            ]
            if kept_handlers:
                new_group = dict(group)
                new_group["hooks"] = kept_handlers
                kept_groups.append(new_group)
        if kept_groups:
            hooks[event_name] = kept_groups
        else:
            hooks.pop(event_name, None)
    data["hooks"] = hooks
    return data


def write_hooks_config() -> Path | None:
    data = strip_managed_hooks(load_json_object(HOOKS_PATH, "hooks.json"))
    hooks = data.setdefault("hooks", {})
    hooks.setdefault("SessionStart", []).append(
        managed_hook_group("SessionStart", 5, "Loading Cardinal session context")
    )
    hooks.setdefault("UserPromptSubmit", []).append(
        managed_hook_group("UserPromptSubmit", 5, "Reporting Cardinal git context")
    )
    hooks.setdefault("Stop", []).append(
        managed_hook_group("Stop", 10, "Reporting Cardinal session telemetry")
    )
    hooks.setdefault("SubagentStop", []).append(
        managed_hook_group("SubagentStop", 5, "Reporting Cardinal subagent telemetry")
    )
    # Hook-side cardinal.decision emission: the agent's sandboxed
    # `cardinal-decision record` only prints a marker. Exact matcher "Bash"
    # (Codex's hook name for exec_command); the handler exits at once
    # unless the command ran cardinal-decision. No statusMessage — it would
    # flash on every shell call.
    post_tool_use = managed_hook_group("PostToolUse", 10)
    post_tool_use["matcher"] = "Bash"
    hooks.setdefault("PostToolUse", []).append(post_tool_use)
    # Generic evidence capture: every tool call (shell, apply_patch, MCP,
    # any tool) is kept in the local evidence spool so a storyboard can cite
    # it. A separate group so the decision emitter above is untouched; ".*"
    # is a regex matcher (hooks/src/events/common.rs matches_matcher: only an
    # alphanumeric matcher is an exact match). Local file work, no network.
    evidence_group = {"matcher": ".*", "hooks": [{
        "type": "command",
        "command": managed_hook_command("ToolEvidence"),
        "timeout": 3,
    }]}
    hooks["PostToolUse"].append(evidence_group)
    # Storyboard context stamping: fills an absent session_id / context on
    # Cardinal's storyboard tools (hooks/cardinal-codex-telemetry.py
    # handle_storyboard_context). A regex matcher: only those calls start
    # the hook. Local git + a gh lookup capped at 2 s.
    hooks.setdefault("PreToolUse", []).append({
        "matcher": STORYBOARD_CONTEXT_MATCHER,
        "hooks": [{
            "type": "command",
            "command": managed_hook_command("StoryboardContext"),
            "timeout": 5,
        }],
    })
    HOOKS_PATH.parent.mkdir(parents=True, exist_ok=True)
    backup_path = backup(HOOKS_PATH)
    atomic_write(HOOKS_PATH, json.dumps(data, indent=2) + "\n")
    return backup_path


def repair_hooks(dry_run: bool = False) -> int:
    """Rewrite the managed hook config without rotating Cardinal credentials.

    Also the supported way to clear Semantic DAG hook entries left behind
    by installs that predate the skill's removal.
    """
    missing = [path for path in (HOOK_SCRIPT,) if not path.is_file()]
    if missing:
        sys.exit("Required hook script is missing: " + ", ".join(map(str, missing)))
    if dry_run:
        print(json.dumps({
            "would_write": {
                "codex_hooks": str(HOOKS_PATH),
                "telemetry_launcher": str(LAUNCHER_PATH),
            },
            "plugin_root": str(PLUGIN_ROOT),
            "plugin_version": PLUGIN_VERSION,
        }, indent=2))
        return 0

    write_launcher()
    print(f"Wrote Cardinal telemetry launcher to {LAUNCHER_PATH}")
    hooks_backup = write_hooks_config()
    print(f"Wrote Cardinal hooks to {HOOKS_PATH}")
    if hooks_backup:
        print(f"Hooks backup: {hooks_backup}")

    if STATE_PATH.exists():
        state = load_json_object(STATE_PATH, "cardinal.json")
        state["plugin_version"] = PLUGIN_VERSION
        atomic_write(STATE_PATH, json.dumps(state, indent=2) + "\n")
        print(f"Updated Cardinal state version in {STATE_PATH}")
    print("Restart Codex so it reloads the repaired hook config.")
    return 0


def write_secrets(bundle: dict) -> None:
    ingest = bundle.get("ingest") or {}
    mcp = bundle.get("mcp") or {}
    payload = {
        "schema_version": 1,
        "ingest_api_key": ingest.get("api_key"),
        "ingest_api_header": ingest.get("api_header") or "x-cardinalhq-api-key",
        "mcp_api_key": mcp.get("api_key"),
        "written_at": datetime.now(timezone.utc).isoformat(),
    }
    # The control-plane token acts as the user across their orgs; it lives only
    # here (0600). migrate-from-grafana reads act_api_key / act_endpoint.
    act = deviceflow.act_credential(bundle)
    if act:
        payload["act_api_key"] = act["api_key"]
        payload["act_endpoint"] = act.get("endpoint")
    atomic_write_secret(SECRETS_PATH, json.dumps(payload, indent=2) + "\n")


def write_state(bundle: dict, host: str, deployment_env: str, telemetry_only: bool) -> None:
    org = bundle.get("org", {})
    user = bundle.get("user", {})
    mcp = bundle.get("mcp") or {}
    ingest = bundle.get("ingest") or {}
    mode = (
        "telemetry-only" if telemetry_only or not mcp
        else "mcp-only" if not ingest
        else "telemetry-and-mcp"
    )
    state = {
        "schema_version": 2,
        "host": host,
        "mode": mode,
        "org_id": org.get("id"),
        "org_slug": org.get("slug"),
        "user_email": user.get("email"),
        "deployment_environment": deployment_env,
        "plugin_version": PLUGIN_VERSION,
        "written_at": datetime.now(timezone.utc).isoformat(),
        "config_path": str(CONFIG_PATH),
        "hooks_path": str(HOOKS_PATH),
        "secrets_path": str(SECRETS_PATH),
        "telemetry": {
            "enabled": bool(ingest),
        },
    }
    reason = deviceflow.ingest_unavailable_reason(bundle)
    if reason:
        # Why the server minted no ingest key, so cardinal-status can say so.
        state["telemetry"]["unavailable_reason"] = reason
    if ingest:
        state["ingest_endpoint"] = ingest.get("endpoint")
        state["ingest_key_id"] = ingest.get("key_id")
        state["ingest_key_prefix"] = (ingest.get("api_key") or "")[:8]
    if mcp:
        state["mcp_url"] = mcp.get("url")
        state["mcp_key_id"] = mcp.get("key_id")
        state["mcp_key_prefix"] = mcp.get("key_prefix") or (mcp.get("api_key") or "")[:8]
        state["mcp_created_at"] = mcp.get("created_at")
    act = deviceflow.act_credential(bundle)
    if act:
        state["act_key_id"] = act.get("key_id")
        state["act_key_prefix"] = act.get("key_prefix")
        state["act_created_at"] = act.get("created_at")
        state["act_scopes"] = deviceflow.act_granted_scopes(act)
    limits = bundle.get("limits")
    if isinstance(limits, dict) and limits.get("status_url"):
        state["limits"] = {
            "status_url": limits["status_url"],
            "enabled": bool(limits.get("enabled", True)),
        }
    atomic_write(STATE_PATH, json.dumps(state, indent=2) + "\n")


def revoke_dropped_act_token(host: str, act: dict | None) -> None:
    """A re-connect whose bundle carries no control-plane token revokes the
    prior one server-side before its key_id leaves the state file — otherwise
    a live "acts as you" token orbits un-revokable."""
    if act:
        return
    def read(path: Path) -> dict:
        try:
            data = json.loads(path.read_text())
        except (OSError, ValueError):
            return {}
        return data if isinstance(data, dict) else {}

    prior = read(STATE_PATH)
    key_id = prior.get("act_key_id")
    if not key_id:
        return
    # Without the plaintext the server answers 403 and we point at the UI.
    plaintext = read(SECRETS_PATH).get("act_api_key")
    ok, msg = deviceflow.revoke_maestro_key(host, key_id, plaintext)
    prefix = prior.get("act_key_prefix") or key_id
    if ok:
        print(f"Revoked prior control-plane token {prefix} server-side ({msg})")
    else:
        print(f"Could not revoke prior control-plane token {prefix} ({msg}).")
        print(f"Visit {host}/settings/api-keys to revoke it manually.")


def continue_after_grant(args: argparse.Namespace, grant: dict) -> int:
    expires_in = int(grant.get("expires_in") or deviceflow.DEFAULT_POLL_TIMEOUT_SECS)
    interval = int(grant.get("interval") or deviceflow.DEFAULT_POLL_INTERVAL_SECS)
    verification_uri = grant.get("verification_uri") or ""

    print()
    print("Open this URL in your browser to approve Cardinal for Codex:")
    print(f"  {verification_uri}")
    print()
    print(f"Waiting up to {expires_in // 60} minute(s) for browser approval...")

    bundle = deviceflow.poll_device_token(
        args.host, grant["device_code"], CLIENT_ID, interval, expires_in
    )
    org = bundle.get("org", {})
    user = bundle.get("user", {})
    ingest = bundle.get("ingest")
    mcp = bundle.get("mcp")
    act = deviceflow.act_credential(bundle)

    # Set when the server granted the other scopes but minted no ingest key
    # (org has no Lakerunner, or no ingest endpoint configured). Connect goes
    # on without telemetry as long as there is an MCP credential to wire.
    ingest_reason = deviceflow.ingest_unavailable_reason(bundle)

    if not ingest and not mcp:
        sys.exit(
            "Cardinal did not return an ingest credential "
            f"({deviceflow.ingest_unavailable_note(ingest_reason or 'unknown', mcp_connected=False)}). "
            "Nothing to connect."
        )
    if not args.telemetry_only and not mcp:
        sys.exit("Cardinal did not return an MCP credential. Check the requested scopes.")

    deployment_env = args.deployment_env or deviceflow.derive_deployment_env(args.host)

    if args.dry_run:
        print(json.dumps(
            {
                "org": org,
                "user": user,
                "deployment_env": deployment_env,
                "would_write": {
                    "codex_config": str(CONFIG_PATH) if mcp else None,
                    "codex_hooks": str(HOOKS_PATH),
                    "telemetry_launcher": str(LAUNCHER_PATH),
                    "state": str(STATE_PATH),
                    "secrets": str(SECRETS_PATH),
                    "ingest_endpoint": (ingest or {}).get("endpoint"),
                    "ingest_unavailable_reason": ingest_reason,
                    "mcp_url": (mcp or {}).get("url"),
                    "act_scopes": deviceflow.act_granted_scopes(act) if act else None,
                },
            },
            indent=2,
        ))
        return 0

    # No ingest credential: nothing to probe, and no telemetry config to
    # write — skip rather than abort so the MCP config still gets written.
    if ingest:
        ok, msg = deviceflow.verify_ingest_reachable(ingest)
        if not ok:
            sys.exit(f"Ingest reachability failed: {msg}")
        print(f"Ingest endpoint reachable ({msg})")

    if mcp:
        ok, msg = deviceflow.verify_mcp_reachable(mcp.get("url"), mcp.get("api_key"))
        if not ok:
            sys.exit(f"MCP reachability failed: {msg}")
        print(f"MCP endpoint reachable ({msg})")

    if not HOOK_SCRIPT.exists():
        sys.exit(f"Telemetry hook script is missing: {HOOK_SCRIPT}")
    if mcp:
        backup_path = write_codex_config(mcp["url"], mcp["api_key"])
        print(f"Wrote Cardinal MCP config to {CONFIG_PATH}")
        if backup_path:
            print(f"Config backup: {backup_path}")

    revoke_dropped_act_token(args.host, act)
    write_secrets(bundle)
    print(f"Wrote Cardinal local secrets to {SECRETS_PATH}")

    write_launcher()
    print(f"Wrote Cardinal telemetry launcher to {LAUNCHER_PATH}")

    hooks_backup = write_hooks_config()
    print(f"Wrote Cardinal hooks to {HOOKS_PATH}")
    if hooks_backup:
        print(f"Hooks backup: {hooks_backup}")

    write_state(bundle, args.host, deployment_env, args.telemetry_only)
    print(f"Wrote Cardinal state to {STATE_PATH}")

    print()
    print(f"Connected as {user.get('email') or 'unknown'} ({org.get('slug') or org.get('id')})")
    if ingest:
        print(f"Telemetry endpoint: {ingest['endpoint']}")
    else:
        print(f"WARN {deviceflow.ingest_unavailable_note(ingest_reason or 'unknown', mcp_connected=bool(mcp))}")
        print("     Re-run cardinal-connect --rotate once telemetry ingest is available.")
    if mcp:
        print(f"MCP endpoint: {mcp['url']}")
    if act:
        granted = deviceflow.act_granted_scopes(act)
        print(f"Actions: enabled ({', '.join(granted)}, key {act.get('key_prefix')})")
        missing = [s for s in getattr(args, "extra_scopes", []) if s not in granted]
        if missing:
            print(f"WARN Not granted: {', '.join(missing)} — the server didn't grant them "
                  "(your org role, or this Cardinal server doesn't offer them yet).")
    elif getattr(args, "act_requested", False):
        print("WARN Cardinal returned no control-plane token: skills that write dashboards or")
        print("     alert rules as you (migrate-from-grafana) need a login token or API key.")
    print()
    print("Restart Codex so it reloads MCP and hook config, then run cardinal-status.")
    return 0


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="cardinal-connect",
        description="Connect Codex to Cardinal's unified MCP endpoint.",
    )
    parser.add_argument(
        "--host",
        default="https://app.cardinalhq.io",
        help="Cardinal app host (default: https://app.cardinalhq.io)",
    )
    parser.add_argument(
        "--rotate",
        action="store_true",
        help="Proceed even if Cardinal state already exists and mint a fresh key.",
    )
    parser.add_argument(
        "--repair-hooks",
        action="store_true",
        help="Refresh the Cardinal launcher and hooks without rotating credentials.",
    )
    parser.add_argument(
        "--telemetry-only",
        action="store_true",
        help="Only configure Cardinal telemetry hooks; skip the MCP credential.",
    )
    parser.add_argument(
        "--deployment-env",
        default=None,
        help="Override deployment.environment (default derived from --host).",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Run the device-code flow and print what would be written.",
    )
    parser.add_argument(
        "scopes", nargs="*", metavar="SCOPE",
        help="Extra scopes for the control-plane token: "
             f"{', '.join(deviceflow.ACT_EXTRA_SCOPES)} (space- or comma-separated). "
             "All are requested by default; naming them only matters with "
             "--minimal-scopes. They let agents create/edit dashboards and alert "
             "rules, and query telemetry (read-only), as you — within your org role.",
    )
    parser.add_argument(
        "--minimal-scopes", action="store_true",
        help="Don't request the control-plane token and its extra scopes by default — "
             "only those named as positional args (none: no token). Skills that write "
             "dashboards or alert rules as you (migrate-from-grafana) then need a "
             "reconnect or an org API key.",
    )
    args = parser.parse_args()
    try:
        args.named_scopes = deviceflow.parse_act_scopes(args.scopes)
    except ValueError as exc:
        parser.error(str(exc))
    return args


def main() -> int:
    args = parse_args()

    if args.repair_hooks:
        return repair_hooks(args.dry_run)

    if STATE_PATH.exists() and not args.rotate:
        try:
            prior = json.loads(STATE_PATH.read_text())
        except Exception:
            prior = {}
        user = prior.get("user_email") or "this account"
        sys.stderr.write(
            f"Cardinal is already connected as {user}. "
            "Re-run with --rotate to overwrite.\n"
        )
        return 2

    scopes = ["ingest:write"]
    if not args.telemetry_only:
        scopes.append("mcp:invoke")
    # The control-plane token (maestro:act) and its extra scopes, so skills can
    # write dashboards / alert rules and query telemetry as the user. Requested
    # by default; scopes the user named are required, the rest are dropped by a
    # Cardinal server that doesn't offer them yet.
    named = args.named_scopes
    extra = deviceflow.default_act_scopes(named, args.minimal_scopes)
    act_scopes = ["maestro:act", *extra] if extra else []
    required = scopes + (["maestro:act", *named] if named else [])
    print(f"Requesting Cardinal consent for scopes: {', '.join(scopes + act_scopes)}")
    if act_scopes:
        print("WARN maestro:act grants a long-lived token that acts as you across your orgs.")
        print(f"     It is stored 0600 in {SECRETS_PATH}; cardinal-disconnect revokes it.")
        for line in deviceflow.act_scope_warnings(extra):
            print(line)
    try:
        grant, requested = deviceflow.start_device_code_with_fallback(
            args.host, required, act_scopes, CLIENT_ID)
        args.act_requested = "maestro:act" in requested
        args.extra_scopes = [s for s in extra if s in requested]
        write_pending(grant)
        try:
            return continue_after_grant(args, grant)
        finally:
            clear_pending()
    except deviceflow.DeviceFlowError as exc:
        sys.exit(str(exc))


if __name__ == "__main__":
    sys.exit(main())
